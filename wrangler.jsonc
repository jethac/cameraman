{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "cameraman",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-08-27",
  "r2_buckets": [
    {
      "binding": "DEMO_BLOBS",
      "bucket_name": "cameraman-web"
    }
  ]
}
