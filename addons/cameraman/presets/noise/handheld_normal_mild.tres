[gd_resource type="Resource" script_class="CameramanNoiseProfile" load_steps=5 format=3]

[ext_resource type="Script" path="res://addons/cameraman/noise/cameraman_noise_profile.gd" id="1"]
[ext_resource type="Script" path="res://addons/cameraman/noise/cameraman_noise_channel.gd" id="2"]
[ext_resource type="Script" path="res://addons/cameraman/noise/cameraman_noise_params.gd" id="3"]

[sub_resource type="Resource" id="NoiseX"]
script = ExtResource("3")
frequency = 1.8
amplitude = 0.015

[sub_resource type="Resource" id="NoiseY"]
script = ExtResource("3")
frequency = 2.2
amplitude = 0.012

[sub_resource type="Resource" id="NoiseZ"]
script = ExtResource("3")
frequency = 1.4
amplitude = 0.01

[sub_resource type="Resource" id="Channel"]
script = ExtResource("2")
x = SubResource("NoiseX")
y = SubResource("NoiseY")
z = SubResource("NoiseZ")

[resource]
script = ExtResource("1")
position_noise = Array[ExtResource("2")]([SubResource("Channel")])
orientation_noise = Array[ExtResource("2")]([SubResource("Channel")])
